# Copier en .env (chargé par : node --env-file=.env server.js) ou exporter via systemd.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Admin : mot de passe unique d'accès à /admin. À CHANGER impérativement.
ADMIN_PASSWORD=change-moi

# Secret de signature des cookies de session. Générer : openssl rand -hex 32
COOKIE_SECRET=remplace-par-un-secret-aleatoire-long

# Emplacement du fichier SQLite (par défaut ./data/wascal.db)
DB_PATH=./data/wascal.db
